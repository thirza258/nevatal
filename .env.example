# Copy to .env and fill in. Every value here is read by docker-compose and
# passed to the containers; nothing in this file should be committed once real.

# --- Required ---------------------------------------------------------------

# Signs sessions AND derives the cipher that protects the provider API keys
# users paste in, so this is the single most important value in the file. There
# is no default: the app refuses to start without it, because starting with a
# guessable secret means anyone holding a captured cookie can read a live
# provider key out of it.
#
#   python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
#
# Changing it later signs everyone out — see API_KEY_FINGERPRINT_SALT below.
SECRET_KEY=

# Hostnames this app will answer for. Requests for anything else are refused.
ALLOWED_HOSTS="localhost, 127.0.0.1"

# Origins allowed to call the API from a browser with credentials. Never "*":
# the API-key cookie rides on these requests, so a wildcard would let any site
# spend a visitor's key.
CORS_ALLOWED_ORIGINS="http://localhost"

# --- Database ---------------------------------------------------------------
# Use a generated password, not a memorable one. This port is not published to
# the host, but the credentials still guard the data.
#
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
POSTGRES_DB="nevatal"
POSTGRES_USER="nevatal"
POSTGRES_PASSWORD=

# Must match the three values above.
DATABASE_URL=postgres://nevatal:CHANGE_ME@db:5432/nevatal

# False selects Postgres via DATABASE_URL; True selects a local SQLite file.
DEVELOPMENT_MODE=False

# --- Security ---------------------------------------------------------------

# Leave off. On, it serves full tracebacks — including settings — to anyone who
# triggers an error.
DEBUG=False

# Requests per client per minute across the whole API. The Batch page fans out
# on purpose, so raise this rather than lowering it if batch runs stall.
ANON_THROTTLE_RATE="180/min"

# How many proxies sit in front of Django, so request throttling counts the
# real caller instead of the proxy. Cloudflare plus nginx is 2.
NUM_PROXIES=2

# Set only when rotating SECRET_KEY: pin this to the *previous* SECRET_KEY and
# existing chat history and Document AI folders stay attached to their owners.
# Users still have to re-enter their API key, which no setting can avoid.
API_KEY_FINGERPRINT_SALT=

# Origins trusted for unsafe cross-origin requests, e.g. "https://your.domain".
CSRF_TRUSTED_ORIGINS=

# Turn on once HTTPS is confirmed working end to end. SECURE_SSL_REDIRECT loops
# forever if the proxy in front does not pass X-Forwarded-Proto, and HSTS is
# remembered by browsers for its full duration and cannot be withdrawn early —
# so ramp it up (300, then 86400, then 31536000) rather than starting high.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# --- Optional ---------------------------------------------------------------

# RSA private key (PEM, or base64-encoded PEM) used to decrypt the provider API
# keys the browser encrypts before sending. Leave it unset and the backend
# generates one on first use, storing it in the media volume at media/.keys/.
API_KEY_PRIVATE_KEY=""

# Serve the OpenAPI schema and its browsers in production. Off by default:
# they enumerate every endpoint and field the API accepts.
SCHEMA_PUBLIC=False
