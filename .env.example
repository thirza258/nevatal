ALLOWED_HOSTS="localhost, 127.0.0.1"
SECRET_KEY="SecretKey"

DATABASE_URL=postgres://postgres:admin123@db:5432/postgres
DEVELOPMENT_MODE=False

POSTGRES_DB="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="admin123"

# Optional. RSA private key (PEM, or base64-encoded PEM) used to decrypt the
# provider API keys the browser encrypts before sending. Leave it unset and the
# backend generates one on first use, storing it in media/.keys/.
API_KEY_PRIVATE_KEY=""